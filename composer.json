{
    "name": "qalainau/filament-warp-contextmenu",
    "description": "Native Filament context menus for rows, cells, selections and pages, with action search, clipboard history, keyboard and touch support.",
    "keywords": [
        "filament",
        "filamentphp",
        "laravel",
        "context-menu",
        "right-click",
        "table",
        "actions",
        "bulk-actions",
        "clipboard",
        "search",
        "keyboard",
        "touch",
        "rtl"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/qalainau-labs/filament-warp-contextmenu",
    "authors": [
        {
            "name": "qalainau",
            "email": "238779+qalainau@users.noreply.github.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://warpui.com/support?plugin=contextmenu",
        "docs": "https://github.com/qalainau-labs/filament-warp-contextmenu-docs",
        "source": "https://github.com/qalainau-labs/filament-warp-contextmenu"
    },
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.3.2",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.6 || ^5.0",
        "pestphp/pest-plugin-livewire": "^4.0 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "Qalainau\\FilamentWarpContextMenu\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Qalainau\\FilamentWarpContextMenu\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Qalainau\\FilamentWarpContextMenu\\WarpContextMenuServiceProvider"
            ]
        },
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "test:lint": "pint --test",
        "analyse": "phpstan analyse"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
